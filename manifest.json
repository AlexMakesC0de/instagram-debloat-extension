{
  "manifest_version": 3,
  "name": "Instagram Debloat",
  "version": "1.0.0",
  "description": "Strips Reels, Explore, stories, suggested posts and vanity metrics out of Instagram. No accounts, no tracking, no network calls.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Instagram Debloat",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": [
        "src/shared/features.js",
        "src/content/selectors.js",
        "src/content/content.js"
      ],
      "css": ["src/content/rules.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["src/content/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
